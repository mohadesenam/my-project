generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  category    String
  description String
  location    String
  year        String
  client      String
  area        String
  coverImage  String
  gallery     String   // JSON array of image URLs
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Service {
  id              Int     @id @default(autoincrement())
  title           String
  slug            String  @unique
  shortDescription String
  fullDescription String
  icon            String
  image           String
  createdAt       DateTime @default(now())
}

model TeamMember {
  id       Int    @id @default(autoincrement())
  name     String
  role     String
  bio      String
  photo    String
  linkedin String?
  order    Int    @default(0)
}

model Testimonial {
  id      Int    @id @default(autoincrement())
  name    String
  company String
  text    String
  rating  Int    @default(5)
  avatar  String
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  serviceType String?
  message     String
  status      String   @default("new")
  createdAt   DateTime @default(now())
}

model NewsletterSubscriber {
  id     Int      @id @default(autoincrement())
  email  String   @unique
  createdAt DateTime @default(now())
}
